<Window x:Class="NativeApp.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brian - Wallpapers" Height="480" Width="520"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Brian - Wallpapers" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="SignOutButton" Content="Sign Out" Margin="16,0,0,0" Padding="8,2"
                    HorizontalAlignment="Right" Click="SignOutButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,12,0,0"
                   Foreground="Gray" TextWrapping="Wrap"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CatalogList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="Gray" FontSize="12"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding StatusLabel}" Width="80"
                                        IsEnabled="{Binding CanBuy}" Click="BuyButton_Click" DataContext="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
